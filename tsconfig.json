{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022"],
        "moduleResolution": "node",
        "rootDir": "./app",
        "outDir": "./build",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["app/**/*"],
    "exclude": [
        "node_modules",
        "build",
        "client",
        "app/__tests__",
        "app/**/*.spec.ts",
        "app/**/tests"
    ]
}
