{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "an example of url shortener using nodejs with typescript",
  "main": "index.ts",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon ./app/bin/www.ts",
    "dev:frontend": "cd client && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc --project ./",
    "build:frontend": "cd client && npm run build",
    "start": "node build/bin/www.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest",
    "test:frontend": "cd client && npm run test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "eslint . --ext .ts",
    "lint:frontend": "cd client && npm run lint",
    "format": "cd client && npm run format"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyentranhau98/url-shortener.git"
  },
  "author": "Hau Nguyen Tran",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nguyentranhau98/url-shortener/issues"
  },
  "homepage": "https://github.com/nguyentranhau98/url-shortener#readme",
  "dependencies": {
    "@types/http-status-codes": "^1.2.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "debug": "^4.3.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "mongoose": "^8.8.0",
    "shortid": "^2.2.16",
    "valid-url": "^1.0.9"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.0",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/mongoose": "^5.10.3",
    "@types/node": "^22.9.0",
    "@types/shortid": "0.0.29",
    "@types/supertest": "^6.0.2",
    "@types/valid-url": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^4.12.0",
    "@typescript-eslint/parser": "^4.12.0",
    "concurrently": "^9.1.0",
    "eslint": "^7.17.0",
    "eslint-config-google": "^0.14.0",
    "husky": "^4.3.6",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint"
    }
  }
}
