# MongoDB Connection (use production MongoDB URL)
CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/url-shortener

# Server Configuration
PORT=3000
NODE_ENV=production

# URL Shortener Configuration
LOCAL_HOSTNAME=https://your-production-domain.com
MAXIMUM_ACCESS=100

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Optional: Monitoring
# NEW_RELIC_LICENSE_KEY=your-key
# SENTRY_DSN=your-dsn
